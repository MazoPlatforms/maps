{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "baseVersion",
    "summary",
    "contributor",
    "operations"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "baseVersion": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "summary": {
      "type": "string",
      "minLength": 5,
      "maxLength": 500
    },
    "contributor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "licenseAgreement"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "licenseAgreement": {
          "const": true
        }
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "operation",
              "id",
              "expected",
              "value"
            ],
            "properties": {
              "operation": {
                "const": "create"
              },
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "expected": {
                "type": "null"
              },
              "value": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "featureType": {
                    "enum": [
                      "place",
                      "building",
                      "building_part",
                      "road",
                      "connector",
                      "land",
                      "land_cover",
                      "land_use",
                      "water",
                      "infrastructure",
                      "bathymetry",
                      "administrative_boundary"
                    ]
                  },
                  "geometry": {
                    "oneOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "type",
                          "coordinates"
                        ],
                        "properties": {
                          "type": {
                            "const": "Point"
                          },
                          "coordinates": {
                            "$ref": "#/$defs/position"
                          }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "type",
                          "coordinates"
                        ],
                        "properties": {
                          "type": {
                            "const": "MultiPoint"
                          },
                          "coordinates": {
                            "type": "array",
                            "items": {
                              "$ref": "#/$defs/position"
                            },
                            "minItems": 1
                          }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "type",
                          "coordinates"
                        ],
                        "properties": {
                          "type": {
                            "const": "LineString"
                          },
                          "coordinates": {
                            "type": "array",
                            "items": {
                              "$ref": "#/$defs/position"
                            },
                            "minItems": 2
                          }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "type",
                          "coordinates"
                        ],
                        "properties": {
                          "type": {
                            "const": "MultiLineString"
                          },
                          "coordinates": {
                            "type": "array",
                            "items": {
                              "type": "array",
                              "items": {
                                "$ref": "#/$defs/position"
                              },
                              "minItems": 2
                            },
                            "minItems": 1
                          }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "type",
                          "coordinates"
                        ],
                        "properties": {
                          "type": {
                            "const": "Polygon"
                          },
                          "coordinates": {
                            "type": "array",
                            "items": {
                              "type": "array",
                              "items": {
                                "$ref": "#/$defs/position"
                              },
                              "minItems": 4
                            },
                            "minItems": 1
                          }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "type",
                          "coordinates"
                        ],
                        "properties": {
                          "type": {
                            "const": "MultiPolygon"
                          },
                          "coordinates": {
                            "type": "array",
                            "items": {
                              "type": "array",
                              "items": {
                                "type": "array",
                                "items": {
                                  "$ref": "#/$defs/position"
                                },
                                "minItems": 4
                              },
                              "minItems": 1
                            },
                            "minItems": 1
                          }
                        }
                      }
                    ]
                  },
                  "properties": {
                    "type": "object"
                  },
                  "sources": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "provider",
                        "id",
                        "release",
                        "url",
                        "license"
                      ],
                      "properties": {
                        "provider": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 512
                        },
                        "id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 512
                        },
                        "release": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 512
                        },
                        "url": {
                          "type": "string",
                          "format": "uri"
                        },
                        "license": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 512
                        }
                      }
                    }
                  }
                },
                "required": [
                  "featureType",
                  "geometry",
                  "properties",
                  "sources"
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "operation",
              "id",
              "expected",
              "value"
            ],
            "properties": {
              "operation": {
                "const": "update"
              },
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "expected": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "value": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "geometry": {
                    "oneOf": [
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "type",
                          "coordinates"
                        ],
                        "properties": {
                          "type": {
                            "const": "Point"
                          },
                          "coordinates": {
                            "$ref": "#/$defs/position"
                          }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "type",
                          "coordinates"
                        ],
                        "properties": {
                          "type": {
                            "const": "MultiPoint"
                          },
                          "coordinates": {
                            "type": "array",
                            "items": {
                              "$ref": "#/$defs/position"
                            },
                            "minItems": 1
                          }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "type",
                          "coordinates"
                        ],
                        "properties": {
                          "type": {
                            "const": "LineString"
                          },
                          "coordinates": {
                            "type": "array",
                            "items": {
                              "$ref": "#/$defs/position"
                            },
                            "minItems": 2
                          }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "type",
                          "coordinates"
                        ],
                        "properties": {
                          "type": {
                            "const": "MultiLineString"
                          },
                          "coordinates": {
                            "type": "array",
                            "items": {
                              "type": "array",
                              "items": {
                                "$ref": "#/$defs/position"
                              },
                              "minItems": 2
                            },
                            "minItems": 1
                          }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "type",
                          "coordinates"
                        ],
                        "properties": {
                          "type": {
                            "const": "Polygon"
                          },
                          "coordinates": {
                            "type": "array",
                            "items": {
                              "type": "array",
                              "items": {
                                "$ref": "#/$defs/position"
                              },
                              "minItems": 4
                            },
                            "minItems": 1
                          }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "type",
                          "coordinates"
                        ],
                        "properties": {
                          "type": {
                            "const": "MultiPolygon"
                          },
                          "coordinates": {
                            "type": "array",
                            "items": {
                              "type": "array",
                              "items": {
                                "type": "array",
                                "items": {
                                  "$ref": "#/$defs/position"
                                },
                                "minItems": 4
                              },
                              "minItems": 1
                            },
                            "minItems": 1
                          }
                        }
                      }
                    ]
                  },
                  "properties": {
                    "type": "object"
                  },
                  "sources": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "provider",
                        "id",
                        "release",
                        "url",
                        "license"
                      ],
                      "properties": {
                        "provider": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 512
                        },
                        "id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 512
                        },
                        "release": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 512
                        },
                        "url": {
                          "type": "string",
                          "format": "uri"
                        },
                        "license": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 512
                        }
                      }
                    }
                  }
                },
                "minProperties": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "operation",
              "id",
              "expected"
            ],
            "properties": {
              "operation": {
                "const": "delete"
              },
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "expected": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "position": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        }
      ],
      "minItems": 2,
      "maxItems": 2
    }
  }
}
