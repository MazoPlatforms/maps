{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mazoplatforms.github.io/maps/schemas/contribution-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "featureType",
    "geometry",
    "properties",
    "sources",
    "administration",
    "status",
    "revision",
    "previous"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "featureType": {
      "enum": [
        "place",
        "building",
        "building_part",
        "road",
        "connector",
        "land",
        "land_cover",
        "land_use",
        "water",
        "infrastructure",
        "bathymetry",
        "administrative_boundary"
      ]
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "coordinates"
      ],
      "properties": {
        "type": {
          "enum": [
            "Point",
            "MultiPoint",
            "LineString",
            "MultiLineString",
            "Polygon",
            "MultiPolygon"
          ]
        },
        "coordinates": {
          "type": "array",
          "minItems": 1
        }
      }
    },
    "properties": {
      "type": "object"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider",
          "id",
          "release",
          "url",
          "license"
        ],
        "properties": {
          "provider": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "release": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "license": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      }
    },
    "administration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset",
        "canonical",
        "intersections"
      ],
      "properties": {
        "dataset": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "canonical": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "province",
            "district",
            "dsDivision"
          ],
          "properties": {
            "province": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "district": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "dsDivision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          }
        },
        "intersections": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "province",
              "district",
              "dsDivision"
            ],
            "properties": {
              "province": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "district": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "dsDivision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            }
          }
        }
      }
    },
    "status": {
      "enum": [
        "added",
        "modified",
        "removed"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "previous": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      ]
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "release",
        "sha256",
        "featureType"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "release": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "featureType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "modified"
            ]
          }
        }
      },
      "then": {
        "required": [
          "upstream"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "added"
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "upstream"
          ]
        }
      }
    }
  ]
}
