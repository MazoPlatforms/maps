{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mazoplatforms.github.io/maps/schemas/feature-v2.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "featureType",
    "geometry",
    "properties",
    "sources",
    "administration",
    "status",
    "revision",
    "previous"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "featureType": {
      "enum": [
        "place",
        "building",
        "building_part",
        "road",
        "connector",
        "land",
        "land_cover",
        "land_use",
        "water",
        "infrastructure",
        "bathymetry",
        "administrative_boundary"
      ]
    },
    "geometry": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "coordinates"
          ],
          "properties": {
            "type": {
              "const": "Point"
            },
            "coordinates": {
              "$ref": "#/$defs/position"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "coordinates"
          ],
          "properties": {
            "type": {
              "const": "MultiPoint"
            },
            "coordinates": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/position"
              },
              "minItems": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "coordinates"
          ],
          "properties": {
            "type": {
              "const": "LineString"
            },
            "coordinates": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/position"
              },
              "minItems": 2
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "coordinates"
          ],
          "properties": {
            "type": {
              "const": "MultiLineString"
            },
            "coordinates": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/position"
                },
                "minItems": 2
              },
              "minItems": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "coordinates"
          ],
          "properties": {
            "type": {
              "const": "Polygon"
            },
            "coordinates": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/position"
                },
                "minItems": 4
              },
              "minItems": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "coordinates"
          ],
          "properties": {
            "type": {
              "const": "MultiPolygon"
            },
            "coordinates": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/position"
                  },
                  "minItems": 4
                },
                "minItems": 1
              },
              "minItems": 1
            }
          }
        }
      ]
    },
    "properties": {
      "type": "object"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider",
          "id",
          "release",
          "url",
          "license"
        ],
        "properties": {
          "provider": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "release": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "license": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      }
    },
    "administration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset",
        "canonical",
        "intersections"
      ],
      "properties": {
        "dataset": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "canonical": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "province",
            "district",
            "dsDivision"
          ],
          "properties": {
            "province": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "district": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "dsDivision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          }
        },
        "intersections": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "province",
              "district",
              "dsDivision"
            ],
            "properties": {
              "province": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "district": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "dsDivision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            }
          }
        }
      }
    },
    "status": {
      "enum": [
        "active",
        "removed"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "previous": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      ]
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "release",
        "sha256",
        "featureType",
        "provider"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "release": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "featureType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    }
  },
  "$defs": {
    "position": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        }
      ],
      "minItems": 2,
      "maxItems": 2
    }
  },
  "title": "Independent Mazo Maps canonical feature"
}
