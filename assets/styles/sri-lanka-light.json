      "source": "transportation",
      "source-layer": "segment",
      "paint": {
        "line-color": "#ffffff",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          6,
          1.6,
          10,
          2.8,
          14,
          5.2,
          16,
          8.2
        ],
        "line-opacity": 0.88
      },
      "minzoom": 5,
      "filter": [
        "==",
        [
          "get",
          "subtype"
        ],
        "road"
      ]
    },
    {
      "id": "road-lines",
      "type": "line",
      "source": "transportation",
      "source-layer": "segment",
      "paint": {
        "line-color": [
          "match",
          [
            "get",
            "class"
          ],
          "motorway",
          "#e8b64b",
          "trunk",
          "#e8b64b",
          "primary",
          "#e8b64b",
          "secondary",
          "#e9e3d1",
          "tertiary",
          "#eee9dc",
          "#fffdf7"
        ],
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          6,
          0.6,
          10,
          1.1,
          14,
          3.1,
          16,
          5.2
        ]
      },
      "minzoom": 5,
      "filter": [
        "==",
        [
          "get",
          "subtype"
        ],
        "road"
      ]
