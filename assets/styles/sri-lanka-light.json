        "line-color": "#9b8c79",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          7,
          0.7,
          14,
          2.2
        ],
        "line-dasharray": [
          2,
          1.5
        ]
      },
      "minzoom": 7,
      "filter": [
        "==",
        [
          "get",
          "subtype"
        ],
        "rail"
      ]
    },
    {
      "id": "transport-water-lines",
      "type": "line",
      "source": "transportation",
      "source-layer": "segment",
      "paint": {
        "line-color": "#8cc4d2",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          7,
          0.7,
          14,
          2.0
