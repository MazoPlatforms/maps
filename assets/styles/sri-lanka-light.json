          [
            "linear"
          ],
          [
            "zoom"
          ],
          12,
          10,
          16,
          14
        ],
        "text-offset": [
          0,
          0.8
        ],
        "text-anchor": "top",
        "text-max-width": 10,
        "symbol-sort-key": [
