      "source": "transportation",
      "source-layer": "segment",
      "paint": {
        "text-color": "#273538",
        "text-halo-color": "#f8faf7",
        "text-halo-width": 1.5
      },
      "minzoom": 12,
      "filter": [
        "all",
        [
          "==",
          [
            "get",
            "subtype"
          ],
          "road"
        ],
        [
          "has",
          "@name"
        ]
      ],
      "layout": {
        "symbol-placement": "line",
        "text-field": [
          "get",
          "@name"
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          12,
          9,
          16,
          12
        ],
        "text-max-angle": 35,
        "symbol-spacing": 300
