      "source-layer": "water",
      "paint": {
        "line-color": "#8cc4d2",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          5,
          0.5,
          13,
          2.2
        ]
      },
      "minzoom": 5,
      "filter": [
        "==",
        [
          "geometry-type"
        ],
        "LineString"
      ]
    },
