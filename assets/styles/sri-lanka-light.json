    "mazo:theme": "light",
    "mazo:release": "See data/sri-lanka/manifest.json"
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "base": {
      "type": "vector",
      "url": "pmtiles://__MAZO_SITE_ROOT__/data/sri-lanka/base.pmtiles",
      "attribution": "\u00a9 <a href=\"https://docs.overturemaps.org/attribution/\">Overture Maps Foundation</a> \u00b7 \u00a9 <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap contributors</a>"
    },
    "transportation": {
      "type": "vector",
      "url": "pmtiles://__MAZO_SITE_ROOT__/data/sri-lanka/transportation.pmtiles",
      "attribution": "\u00a9 <a href=\"https://docs.overturemaps.org/attribution/\">Overture Maps Foundation</a> \u00b7 \u00a9 <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap contributors</a>"
    },
    "buildings": {
      "type": "vector",
      "url": "pmtiles://__MAZO_SITE_ROOT__/data/sri-lanka/buildings.pmtiles",
      "attribution": "\u00a9 <a href=\"https://docs.overturemaps.org/attribution/\">Overture Maps Foundation</a> \u00b7 \u00a9 <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap contributors</a>"
    },
    "places": {
      "type": "vector",
      "url": "pmtiles://__MAZO_SITE_ROOT__/data/sri-lanka/places.pmtiles",
      "attribution": "\u00a9 <a href=\"https://docs.overturemaps.org/attribution/\">Overture Maps Foundation</a> \u00b7 \u00a9 <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap contributors</a>"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#f5f7f5"
      }
    },
    {
      "id": "land-cover",
      "type": "fill",
      "source": "base",
      "source-layer": "land_cover",
      "paint": {
        "fill-color": "#e4ebdf",
        "fill-opacity": 0.72
      },
      "minzoom": 3,
      "filter": [
        "==",
        [
          "geometry-type"
        ],
        "Polygon"
      ]
    },
    {
      "id": "land",
      "type": "fill",
      "source": "base",
      "source-layer": "land",
      "paint": {
        "fill-color": "#edf0ea"
      },
      "minzoom": 2,
      "filter": [
        "==",
        [
          "geometry-type"
        ],
        "Polygon"
      ]
    },
    {
      "id": "land-use",
      "type": "fill",
      "source": "base",
      "source-layer": "land_use",
      "paint": {
        "fill-color": [
          "match",
          [
            "get",
            "subtype"
          ],
          "residential",
          "#e7e5d8",
          "commercial",
          "#e7e5d8",
          "industrial",
          "#e7e5d8",
          "park",
          "#e4ebdf",
          "forest",
          "#e4ebdf",
          "#e7e5d8"
        ],
        "fill-opacity": 0.65
